<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                      https://maven.apache.org/xsd/settings-1.0.0.xsd">

  <servers>
    <server>
      <id>alon-basic-repo</id>
      <username>alone@kayhut.com</username>
      <password>${JFROG_PASSWORD}</password>
    </server>
  </servers>


  <profiles>
    <profile>
      <id>alon-offline-profile</id>
      <repositories>
        <repository>
          <id>alon-basic-repo</id>
          <url>https://trialo0su9q.jfrog.io/artifactory/alon-basic-repo</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>true</enabled></snapshots>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>alon-basic-repo</id>
          <url>https://trialo0su9q.jfrog.io/artifactory/alon-basic-repo</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>alon-offline-profile</activeProfile>
  </activeProfiles>

</settings>